{
  "input": {
    "chat_template_mask": true,
    "sections": [{"field": "messages", "action": "$role", "template": true}]
  },
  "preprocessing": {
    "max_seq_len": 8192,
    "max_packed_len": 8192,
    "overflow": "truncate",
    "packing": "bfd"
  },
  "output": {
    "record_keys": ["sequence", "loss_mask", "seq_lengths"],
    "dtype": {"loss_mask": "bool"}
  }
}
